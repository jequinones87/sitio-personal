# Copia este archivo a .env.local y rellena los valores.
# Vite expone solo variables prefijadas con VITE_ al cliente.

# EmailJS — https://www.emailjs.com/
# 1. Crea cuenta gratuita en emailjs.com
# 2. Add Service → conecta tu Gmail (jequinones87@gmail.com) → copia el Service ID
# 3. Email Templates → crea template con variables: {{from_name}}, {{from_email}}, {{message}} → copia el Template ID
# 4. Account → Public Key → cópiala aquí
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
